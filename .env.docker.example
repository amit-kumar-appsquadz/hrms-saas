# B1-08 — docker-compose local dev/test defaults (DEV-ONLY, NOT SECRETS)
#
# These values are intentionally weak, well-known, and committed. They exist so
# `docker compose up` works out of the box on a laptop with ZERO real secrets.
# NEVER reuse any of these anywhere real. Production credentials live in AWS
# Secrets Manager (devops, Sprint 7+), never in the repo (steering rule 4).
#
# Usage:
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d
# (compose also reads these as defaults if you don't pass --env-file, because
#  every value below has a built-in fallback in docker-compose.yml.)

# ---- MySQL (RDS stand-in) ----
MYSQL_DATABASE=hrms
MYSQL_USER=hrms
MYSQL_PASSWORD=hrms_local_dev_only
MYSQL_ROOT_PASSWORD=root_local_dev_only
MYSQL_PORT=3306

# ---- MongoDB (MongoDB Atlas stand-in, ADR-003) ----
MONGO_INITDB_DATABASE=hrms_audit
MONGO_INITDB_ROOT_USERNAME=hrms
MONGO_INITDB_ROOT_PASSWORD=mongo_local_dev_only
MONGO_PORT=27017

# ---- Redis (cache + queue) ----
REDIS_PORT=6379

# ---- MinIO (S3 stand-in) ----
MINIO_ROOT_USER=hrms_minio_dev
MINIO_ROOT_PASSWORD=minio_local_dev_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DEFAULT_BUCKET=hrms-local

# ---- App-facing domain (ADR-001 / ADR-007: base domain + *.app.example.com ONLY) ----
# There is NO separate admin hostname. The platform plane lives under
# app.example.com/platform/* on the SAME base domain.
APP_BASE_DOMAIN=app.example.com
APP_TENANT_DOMAIN_SUFFIX=.app.example.com
