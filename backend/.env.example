APP_NAME=HRMS
APP_ENV=local
# Generate per-environment with `php artisan key:generate`. Never commit a real key.
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

# Base domain + per-tenant subdomain pattern (ADR-001 / ADR-007). No admin host.
APP_BASE_DOMAIN=app.example.com

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Transactional data: MySQL (RDS in prod; MySQL via docker-compose locally) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hrms
DB_USERNAME=hrms
DB_PASSWORD=

# --- Octane (steering: Laravel Octane) ---
OCTANE_SERVER=swoole

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Queues: SQS in prod (per-workload + DLQ, ADR-004); sync/redis locally ---
QUEUE_CONNECTION=sync
SQS_PREFIX=
SQS_QUEUE=default
SQS_SUFFIX=

# --- Redis (cache, session, queue locally) ---
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Object storage: S3 in prod; MinIO locally (set by docker-compose, B1-08) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
