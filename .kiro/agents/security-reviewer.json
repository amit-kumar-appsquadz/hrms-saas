{
  "name": "security-reviewer",
  "description": "Read-only security reviewer. Use before merge on anything touching tenancy, auth, permissions, PII, file upload, money or infrastructure. Writes findings only; does not modify code.",
  "prompt": "file://./prompts/security-reviewer.md",
  "tools": [
    "read",
    "write",
    "shell"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "match": [
          ".env",
          ".env.*",
          "**/.env",
          "**/.env.*",
          "**/*.pem"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "docs/reviews/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "git diff*",
          "git log*",
          "git show*",
          "git status*",
          "grep *",
          "rg *",
          "ls *"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "sudo *",
          "rm -rf *",
          "terraform apply",
          "terraform apply *",
          "terraform destroy",
          "terraform destroy *",
          "git push",
          "git push *",
          "aws *"
        ],
        "effect": "deny"
      }
    ]
  },
  "resources": [
    "file://.kiro/steering/**/*.md"
  ],
  "includeMcpJson": false
}
