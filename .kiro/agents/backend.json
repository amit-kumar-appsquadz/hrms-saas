{
  "name": "backend",
  "description": "Laravel backend engineer. Use for APIs, migrations, models, policies, queues/jobs, tenancy, auth, and integrations. Implements against openapi.yaml.",
  "prompt": "file://./prompts/backend.md",
  "tools": [
    "read",
    "write",
    "shell"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "match": [
          ".env",
          ".env.*",
          "**/.env",
          "**/.env.*",
          "**/*.pem"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "backend/**",
          "frontend/**",
          "docker-compose*.yml",
          ".github/**",
          ".env.example",
          "Makefile",
          "docs/notes/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "php *",
          "composer *",
          "npm *",
          "npx *",
          "git *",
          "docker compose *",
          "docker-compose *",
          "make *",
          "./vendor/bin/*",
          "vendor/bin/*",
          "mkdir *",
          "ls *"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "sudo *",
          "rm -rf *",
          "terraform apply",
          "terraform apply *",
          "terraform destroy",
          "terraform destroy *",
          "git push",
          "git push *",
          "aws *"
        ],
        "effect": "deny"
      }
    ]
  },
  "resources": [
    "file://.kiro/steering/**/*.md"
  ],
  "includeMcpJson": false
}
