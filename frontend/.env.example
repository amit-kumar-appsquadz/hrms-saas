# HRMS frontend environment.
# Tenant is resolved from the subdomain (ADR-001). In local dev the tenant slug
# can be simulated via this fallback when the host has no subdomain.
NEXT_PUBLIC_DEFAULT_TENANT=acme

# Data mode: "demo" uses the local demo-service layer; "live" calls the real API
# defined by openapi.yaml. The demo build ships in "demo" mode so the client can
# navigate the full product before every backend endpoint exists.
NEXT_PUBLIC_DATA_MODE=demo

# Base API URL template. {tenant} is replaced with the resolved subdomain slug.
NEXT_PUBLIC_API_BASE_URL=https://{tenant}.app.example.com/api/v1
